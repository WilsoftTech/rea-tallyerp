{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accounting Workspace",
  "version": "0.1.0",
  "identifier": "com.wilsoft.accounting.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Accounting Workspace","width":1180,"height":820,"minWidth":780,"minHeight":620}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.ico", "icons/32x32.png"]}
}
