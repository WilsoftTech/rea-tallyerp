{
  "name": "offline-accounting-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first accounting domain; Phase 2 only, product identity undecided.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:foundation": "node tools/check-foundation.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages --max-warnings 0",
    "build": "tsc -b packages/domain packages/application",
    "check:built": "node tools/check-built.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
